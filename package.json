{
  "name": "infinity-men2-law-office",
  "version": "1.1.0",
  "private": true,
  "description": "Infinity MEN2 Law Office Management PWA and Capacitor Android project",
  "scripts": {
    "build:bridge": "esbuild native-features.js --bundle --platform=browser --target=es2020 --format=iife --outfile=native-features.bundle.js",
    "build:mobile": "npm run build:bridge && node scripts/build-mobile.js",
    "serve": "npm run build:bridge && http-server . -p 4173 -c-1",
    "android:add": "npm run build:mobile && cap add android && npm run assets:generate && npm run build:mobile && cap sync android",
    "android:sync": "npm run build:mobile && npm run assets:generate && npm run build:mobile && cap sync android",
    "android:open": "cap open android",
    "assets:generate": "capacitor-assets generate --android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "esbuild": "^0.25.0",
    "http-server": "^14.1.1",
    "@capacitor/assets": "^4.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
