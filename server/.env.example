PORT=8787
# Comma-separated exact origins for the hosted PWA and the Capacitor Android WebView.
# Examples only: replace the website host with the real deployed HTTPS origin.
APP_ORIGINS=https://your-app-domain.example,https://localhost
VAPID_SUBJECT=mailto:replace-with-your-real-email@example.com
# Use a long random secret. Keep it on the server only; never put it in config.js.
PUSH_API_KEY=replace-with-a-long-random-secret
